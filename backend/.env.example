# ===== ฐานข้อมูล PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE_NAME=dashboard_db
# (ไม่บังคับ) ถ้าไม่ใส่ ระบบสร้างจากค่า DB_* ให้เอง
# DATABASE_URL=postgres://postgres:password@localhost:5432/dashboard_db

# ===== ความปลอดภัย =====
# ต้องตั้ง! สร้างค่าสุ่มด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=
# development = ปิด rate limit, production = เปิด rate limit + cookie secure (ต้องใช้ HTTPS)
ENVIRONMENT=development
# URL ของหน้าเว็บ (frontend) ที่อนุญาตให้เรียก API — หลายค่าคั่นด้วย ,
FRONTEND_URL=http://localhost:3000
PORT=4000

# ===== ค่าเริ่มต้นของระบบ (ใช้ครั้งแรกตอน npm run setup เท่านั้น หลังจากนั้นแก้ในหน้าเว็บ "ตั้งค่าระบบ") =====
B_YEAR=2569
ZONE_CODE=11
CHW_CODE=81
AMP_CODE=8106

# ===== บัญชีผู้ดูแลระบบคนแรก (สร้างตอน npm run setup) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FIRSTNAME=
ADMIN_LASTNAME=
ADMIN_DEPARTMENT=
